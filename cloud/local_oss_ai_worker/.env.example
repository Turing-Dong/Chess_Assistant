OSS_BUCKET=esp32-chess-assistant
DEVICE_IDS=chess-AABBCCDDEEFF,chess-112233445566
DISCOVER_DEVICES=false
OSS_REGION=cn-hangzhou
ALIYUN_ACCESS_KEY_ID=replace-with-your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
# ALIYUN_SECURITY_TOKEN=replace-with-your-sts-token
# CHESS_AI_API_KEY=replace-with-your-ai-api-key
# CHESS_AI_PROVIDER=qwen
# CHESS_AI_MODEL=qwen3-vl-plus
# CHESS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHESS_AI_ENABLE_REVIEW=true
# CHESS_AI_REVIEW_MODE=auto
# CHESS_AI_REVIEW_MIN_CONFIDENCE=0.85
# CHESS_AI_REVIEW_MIN_ORIENTATION_CONFIDENCE=0.35
# CHESS_AI_ENABLE_GRID_SNAP=true
# CHESS_AI_ENABLE_DUPLICATE_RESOLVE=true
# CHESS_AI_MAX_VISIBLE_PIECES=32
# CHESS_AI_REQUIRE_VISUAL_EVIDENCE=true
# CHESS_AI_ENABLE_CROP_SHEET=true
# CHESS_AI_ENABLE_CANDIDATE_CLASSIFIER=true
# CHESS_AI_ENABLE_KING_CLASSIFIER=true
# Local PP-LCNet runs before the cloud candidate classifier. Low-confidence
# candidates automatically fall back to the existing cloud classifier.
# CHESS_LOCAL_CLASSIFIER_ENABLED=true
# CHESS_LOCAL_CLASSIFIER_MODEL_DIR=..\local_piece_classifier\output\xiangqi_pplcnet_x1_0_finetune\inference
# CHESS_LOCAL_CLASSIFIER_DEVICE=cpu
# CHESS_LOCAL_CLASSIFIER_BACKEND=auto
# CHESS_LOCAL_CLASSIFIER_PYTHON=..\local_piece_classifier\.venv\Scripts\python.exe
# CHESS_LOCAL_CLASSIFIER_MIN_CONFIDENCE=0.50
# CHESS_LOCAL_CLASSIFIER_MIN_MARGIN=0.10
# CHESS_LOCAL_CLASSIFIER_CROP_SCALE=1.35
# CHESS_LOCAL_CLASSIFIER_CLOUD_FALLBACK=true
# CHESS_AI_CURL_FALLBACK=true
# CHESS_ENGINE_ENABLED=true
# CHESS_ENGINE_PATH=C:\\path\\to\\fairy-stockfish.exe
# CHESS_ENGINE_MOVETIME_MS=1500
# CHESS_ENGINE_TIMEOUT_MS=20000
# Fairy-Stockfish Xiangqi UCI moves use ranks 1-10; use 0 for a 0-9 engine.
# CHESS_ENGINE_COORDINATE_BASE=1
# CHESS_VISUAL_EVIDENCE_MAX_DISTANCE=30
# Downloaded source images are decoded and center-cropped to 1080x1080 before
# geometry detection. The source manifest dimensions remain unchanged in the
# device-facing result protocol.
# CHESS_CENTER_CROP_JPEG_QUALITY=95
# Anchor the first vertical grid line relative to the crop's left edge.
# CHESS_GRID_ANCHOR_LEFT_REFERENCE=true
# CHESS_GRID_LEFT_REFERENCE_RATIO=0.117
# CHESS_GRID_LEFT_REFERENCE_SEARCH_IMAGE_RATIO=0.03
# CHESS_GRID_LEFT_REFERENCE_SEARCH_SPACING_RATIO=0.25
# CHESS_GRID_LEFT_REFERENCE_MIN_WEIGHT_RATIO=0.50
# CHESS_OPENCV_MAX_CANDIDATES=32
# CHESS_CIRCLE_MIN_ACCEPT_RADIUS=29
# CHESS_CIRCLE_MAX_EMPTY_GRAY=225
# CHESS_CIRCLE_MIN_PIECE_SATURATION=85
# CHESS_CIRCLE_MAX_PIECE_SATURATION=190
# CHESS_CIRCLE_MIN_CENTER_DARK_RATIO=0.12
# CHESS_CIRCLE_MIN_BODY_DARK_RATIO=0.20
# CHESS_CIRCLE_MAX_EMPTY_BODY_STD=36
# CHESS_CIRCLE_CROP_EDGE_MARGIN_RATIO=1.05
# CHESS_CIRCLE_MAX_DARK_REGION_GRAY=105
# CHESS_CIRCLE_MIN_DARK_REGION_BODY_RATIO=0.60
# A dark region is rejected only when its narrow circular rim is weaker than this.
# CHESS_CIRCLE_MAX_DARK_REGION_NARROW_RING_COVERAGE=0.67
# CHESS_CIRCLE_REQUIRE_GRID_ALIGNMENT=true
# CHESS_CIRCLE_MAX_GRID_OFFSET_RATIO=0.44
# Candidate coordinates are snapped before AI recognition; this is the maximum
# normalized offset recorded as a confident snap.
# CHESS_CANDIDATE_GRID_SNAP_MAX_OFFSET=0.44
# Fuse grid-point ROI occupancy with Hough evidence before sending candidates to AI.
# CHESS_GRID_ROI_HOUGH_FUSION=true
# CHESS_GRID_ROI_EXPECTED_RADIUS_RATIO=0.445
# CHESS_GRID_ROI_HOUGH_MAX_DISTANCE_RATIO=0.45
# CHESS_GRID_ROI_MIN_RADIUS_RATIO=0.62
# CHESS_GRID_ROI_MAX_RADIUS_RATIO=1.30
# CHESS_GRID_ROI_FUSION_ROI_WEIGHT=0.65
# CHESS_GRID_ROI_FUSION_HOUGH_WEIGHT=0.35
# CHESS_GRID_ROI_FUSION_THRESHOLD=0.46
# CHESS_GRID_ROI_FUSION_FALLBACK_ON_EMPTY=true
# Infer the bottom side from the vertical distribution of red/black piece text
# before assigning canonical board_x/board_y coordinates.
# CHESS_ORIENTATION_DETECTION=true
# CHESS_ORIENTATION_MIN_COLOR_SAMPLES=4
# CHESS_ORIENTATION_MIN_SCORE=0.12
# CHESS_ORIENTATION_ROTATE_BOTTOM_SIDE_CROPS=true
# Reject side-specific OCR characters when their implied red/black side conflicts
# with a sufficiently confident local text-color estimate.
# CHESS_CHARACTER_COLOR_CONFLICT_MIN_MARGIN=0.35
# CHESS_DEBUG_SAVE_CANDIDATE_CROPS=true
# CHESS_CANDIDATE_CROP_SCALE=1.55
# CHESS_OPENCV_SUPPRESS_GRID_LINES=true
# Detect on the rectified color image and a grid-suppressed copy, then fuse.
# CHESS_OPENCV_DUAL_CIRCLE_DETECTION=true
# CHESS_CIRCLE_FUSION_MIN_RADIUS_RATIO=0.60
# CHESS_CIRCLE_FUSION_MAX_DISTANCE_RATIO=0.65
# Reject a one-branch-only circle when its grid offset is implausibly large.
# CHESS_CIRCLE_FILTER_WEAK_SINGLE_SOURCE=true
# CHESS_CIRCLE_SINGLE_SOURCE_MAX_GRID_OFFSET=0.40
# CHESS_OPENCV_DETECT_GRID_CROP=true
# Preserve complete edge pieces when rectifying the detected board frame.
# CHESS_RECTIFIED_BOARD_MARGIN_X=0.07
# CHESS_RECTIFIED_BOARD_MARGIN_TOP=0.12
# CHESS_RECTIFIED_BOARD_MARGIN_BOTTOM=0.12
# CHESS_GRID_CROP_HOUGH_MIN_LINE=59
# CHESS_GRID_CROP_HOUGH_MAX_GAP=24
# CHESS_GRID_CROP_HOUGH_THRESHOLD=45
# CHESS_GRID_CROP_CLUSTER_TOLERANCE=0.012
# CHESS_GRID_CROP_MIN_WIDTH_RATIO=0.45
# CHESS_GRID_CROP_MIN_HEIGHT_RATIO=0.55
# CHESS_GRID_LINE_MASK_WIDTH=7
# CHESS_GRID_INPAINT_RADIUS=3
# CHESS_CROP_SHEET_TILE_SIZE=160
# CHESS_CROP_SHEET_COLUMNS=4
# CHESS_CROP_SHEET_SCALE=1.35
# Ask a separate text-only AI pass for moves after recognition and snapping.
# CHESS_AI_SEPARATE_MOVE_DECISION=false
# CHESS_AI_DECISION_MODEL=qwen-plus
# Reject AI output that classifies too few filtered circle candidates.
# CHESS_AI_REQUIRE_CANDIDATE_COVERAGE=true
# CHESS_AI_MIN_CANDIDATE_COVERAGE=0.85
# CHESS_CIRCLE_MIN_RADIUS=14
# CHESS_CIRCLE_MAX_RADIUS=32
# CHESS_CIRCLE_MIN_DIST=28
# CHESS_CIRCLE_PARAM1=80
# CHESS_CIRCLE_PARAM2=26
# CHESS_CIRCLE_RING_EDGE_RESCUE=true
# CHESS_CIRCLE_MIN_RING_EDGE_COVERAGE=0.70
# CHESS_CIRCLE_RING_EDGE_BINS=36
# CHESS_CIRCLE_NARROW_RING_EDGE_BINS=72
# CHESS_CIRCLE_NARROW_RING_BAND_RATIO=0.10
# CHESS_CIRCLE_MIN_NARROW_RING_EDGE_COVERAGE=0.70
# CHESS_CIRCLE_MIN_OUTSIDE_CROP_RING_COVERAGE=0.70
# CHESS_CIRCLE_RING_CANNY_LOW=45
# CHESS_CIRCLE_RING_CANNY_HIGH=120
# CHESS_GRID_DISAMBIGUATE_RADIUS=1
# Effective 9x10 grid-intersection frame, separate from the outer rectification frame.
# CHESS_BOARD_CORNERS=0.117,0.913,0.878,0.913,0.878,0.127,0.117,0.127
# CHESS_BOARD_CROP=0.117,0.127,0.878,0.913
